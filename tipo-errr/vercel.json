{
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/acess",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=:path*"
    },
    {
      "source": "/account",
      "destination": "/profile.html"
    },
    {
      "source": "/account/:username",
      "destination": "/profile.html?u=:username"
    },
    {
      "source": "/account/:path*",
      "destination": "/profile.html?u=:path*"
    },
    {
      "source": "/groups/:groupId",
      "destination": "/chat.html?group=:groupId"
    },
    {
      "source": "/messages/:username",
      "destination": "/chat.html"
    },
    {
      "source": "/administracao",
      "destination": "/verificacao.html"
    },
    {
      "source": "/acess",
      "destination": "/acess.html"
    },
    {
      "source": "/gerenciador/anúncios.html",
      "destination": "/gerenciador/anuncios.html"
    },
    {
      "source": "/gerenciador/anuncios",
      "destination": "/gerenciador/anuncios.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/developers-services",
      "destination": "/developers-services.html"
    },
    {
      "source": "/maintenance",
      "destination": "/maintenance.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
