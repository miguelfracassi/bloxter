{
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=:path*"
    },
    {
      "source": "/account",
      "destination": "/profile.html"
    },
    {
      "source": "/account/:username",
      "destination": "/profile.html?u=:username"
    },
    {
      "source": "/account/:path*",
      "destination": "/profile.html?u=:path*"
    },
    {
      "source": "/groups/:groupId",
      "destination": "/chat.html?group=:groupId"
    },
    {
      "source": "/messages/:username",
      "destination": "/chat.html"
    },
    {
      "source": "/administracao",
      "destination": "/verificacao.html"
    },
    {
      "source": "/acess",
      "destination": "/acess.html"
    },
    {
      "source": "/gerenciador/anúncios.html",
      "destination": "/gerenciador/anuncios.html"
    },
    {
      "source": "/gerenciador/anuncios",
      "destination": "/gerenciador/anuncios.html"
    },
    {
      "source": "/institutional",
      "destination": "/institutional.html"
    },
    {
      "source": "/discord",
      "destination": "/discord.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/developers-services",
      "destination": "/developers-services.html"
    },
    {
      "source": "/maintenance",
      "destination": "/maintenance.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/offline",
      "destination": "/offline.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(icon|icon-192|icon-512|icon-maskable-512|apple-touch-icon).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}